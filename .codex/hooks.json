{
  "description": "Mia-only advisory resume and evidence hooks; no model edits, blockers or auto-continuations.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume",
      "hooks": [{
        "type": "command",
        "command": "python -c \"import subprocess,runpy;from pathlib import Path;p=Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip());runpy.run_path(str(p/'tools/mia/pipeline/hooks.py'),run_name='__main__')\"",
        "timeout": 10,
        "additionalContextLimit": 4000
      }]
    }],
    "PostCompact": [{
      "hooks": [{
        "type": "command",
        "command": "python -c \"import subprocess,runpy;from pathlib import Path;p=Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip());runpy.run_path(str(p/'tools/mia/pipeline/hooks.py'),run_name='__main__')\"",
        "timeout": 10,
        "additionalContextLimit": 4000
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "python -c \"import subprocess,runpy;from pathlib import Path;p=Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip());runpy.run_path(str(p/'tools/mia/pipeline/hooks.py'),run_name='__main__')\"",
        "timeout": 10,
        "additionalContextLimit": 1500
      }]
    }]
  }
}
